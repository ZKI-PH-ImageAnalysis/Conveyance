{
    "model": {
        "name": "toymodel4l"
    },
    "loss": {
        "name": "selalpha_dl",
        "alpha": 1,
        "beta": 1,
        "delta": 1e-3,
        "drainage_idx": 10,
        
        "pass_model_to_loss": true
    },
    "dataset": {
        "name": "mnist",
        "num_classes": 10,
        "train_batchsize": 128,
        "test_batchsize": 256,
        "num_workers": 4
    },
    "optim": {
        "total_epoch": 50,
        
        "optimizer": "sgd",
        "learning_rate": 0.01,
        "momentum": 0.9,
        "weight_decay": 0,

        "grad_bound": 5.0,
        
        "scheduler": "cosine",
        "step_size": 15,
        "gamma": 0.1,
        "T_max": 50,
        "eta_min": 0
    }
}